    {
      "parameters": {
        "jsCode": "// Get the list of names from the previous node\nconst names = $input.all();\n\nconsole.log('Raw input:', JSON.stringify(names, null, 2));\n\n// The Manual Trigger sends the array as a single item\n// Extract the array from the first item\nconst nameArray = names[0].json['List of Names'];\n\nconsole.log('Name array:', nameArray);\n\n// Filter names that start with \"E\"\nconst filteredNames = nameArray.filter(name => \n  name && typeof name === 'string' && name.trim().toUpperCase().startsWith('E')\n);\n\nconsole.log('Filtered names:', filteredNames);\n\n// Return the filtered names as individual items\nreturn filteredNames.map(name => {\n  return {\n    json: {\n      original_name: name\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "c9166e2d-c464-460f-a424-fb45bef9294a",
      "name": "Code in JavaScript",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Get all filtered names\nconst items = $input.all();\n\n// Add custom greeting to each name\nconst greetedItems = items.map(item => {\n  const name = item.json.original_name;\n  return {\n    json: {\n      name: name,\n      greeting: `Hello ${name}! Welcome to the E-name club!`,\n      timestamp: new Date().toISOString()\n    }\n  };\n});\n\nreturn greetedItems;"
      },
